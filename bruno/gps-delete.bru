# Delete GPS points in a time range (DESTRUCTIVE — permanent).
# Requires ENABLE_GPS_EDIT=true on the server, otherwise 403.
# Always run the preview first and compare the count.

# --- 1. PREVIEW: how many rows would go? Deletes nothing. ---
delete {
  baseUrl
}
params {
  deviceId: 08:D1:F9:C8:4D:24
  start: 2026-10-10T15:00:00.000Z
  end: 2026-10-10T17:00:00.000Z
  preview: 1
}
body {
  mode: raw
}
auth {
  type: none
}

### Expect 200 { "count": <n>, "preview": true }. If 403, ENABLE_GPS_EDIT is not set on the target server.

---

# --- 2. Refused without the env flag (expect 403) ---
delete {
  baseUrl
}
params {
  deviceId: 08:D1:F9:C8:4D:24
}
body {
  mode: raw
}
auth {
  type: none
}

### Expect 403 { "error": "GPS editing is disabled on this server" }.

---

# --- 3. Refused without a time window (expect 400) ---
delete {
  baseUrl
}
params {
  deviceId: 08:D1:F9:C8:4D:24
}
body {
  mode: raw
}
auth {
  type: none
}

### Expect 400 "start and/or end required" — guards against wiping a boat's whole history.

---

# --- 4. Refused without a deviceId (expect 400) ---
delete {
  baseUrl
}
params {
  start: 2026-10-10T15:00:00.000Z
  end: 2026-10-10T17:00:00.000Z
}
body {
  mode: raw
}
auth {
  type: none
}

### Expect 400 "deviceId query param required".

---

# --- 5. THE REAL DELETE — verify step 1's count first. ---
delete {
  baseUrl
}
params {
  deviceId: 08:D1:F9:C8:4D:24
  start: 2026-10-10T15:00:00.000Z
  end: 2026-10-10T17:00:00.000Z
}
body {
  mode: raw
}
auth {
  type: none
}

### Expect 200 { "deleted": <n> }. Permanent. Matches the preview count.
