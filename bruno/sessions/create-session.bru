meta {
  name: Create session (course + boats in one call)
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/sessions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "courseId": 34,
    "name": "Saturday stick — 2026-10-09",
    "date": "2026-10-09",
    "mode": "practice",
    "originLat": 39.92,
    "originLon": 9.65,
    "windDir": 265,
    "startTime": "2026-10-09T13:00:00.000Z",
    "boats": [
      { "deviceId": "08:D1:F9:C8:4D:24" }
    ]
  }
}

docs {
  courseId  = lineage into the courses table (snapshot + marks are frozen onto
              the session either way)
  boats[]   = the participants. THIS IS THE ONLY MOMENT they can be declared
              (todo 55): there is no add/remove endpoint. An id the server has
              never seen is recorded immediately as a device named "Boat XXXX"
              (no lastSeen, so it reads offline until it heartbeats) and can be
              renamed later in the boats pane.
  409       = this boat is already in another scheduled/live session
}