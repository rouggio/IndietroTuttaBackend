meta {
  name: Update session (wind shift re-resolve)
  type: http
  seq: 23
}

put {
  url: {{baseUrl}}/sessions/:id
  body: json
  auth: none
}

params:path {
  id: 230
}

body:json {
  {
    "windDir": 300,
    "status": "scheduled"
  }
}

docs {
  Target is 230, the abandoned test session: `status: "scheduled"` is the
  re-open path (abandoned is the only other accepted value). Changing the
  geometry bumps the session's own courseVersion and drops any frozen
  standings snapshot.
}
