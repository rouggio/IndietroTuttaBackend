meta {
  name: Next sim sample
  type: http
  seq: 41
}

get {
  url: {{baseUrl}}/sim/next?deviceId={{deviceId}}
  body: none
  auth: none
}

docs {
  200 with a scripted sample while a run is live for the device, else a
  wander fix seeded from anchor -> this boat's last fix -> newest fix in
  the DB. 404 only when there is no run AND nothing at all to seed from.
}
