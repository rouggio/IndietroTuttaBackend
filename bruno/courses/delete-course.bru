meta {
  name: Delete course
  type: http
  seq: 15
}

delete {
  url: {{baseUrl}}/courses/:id
  body: none
  auth: none
}

params:path {
  id: 42
}

docs {
  Target is 42 "Reversal proof", a scratch user course. Permanent, and local
  :3000 shares the LIVE Turso DB. A built-in (34-38) answers 403.

  Sessions keep their own frozen snapshot, so deleting the course a session
  was created from does not touch that session's geometry.
}

